# The Vercel CLI does not apply .gitignore: never upload secrets, local env or test output.
.env
.env.*
!.env.example
.venv/
.cache/
probe_out/
__pycache__/
*.pyc
.vercel/
photos_test/
# Web app (Vite/React): deployed by its own Vercel project (lauz-hack-webapp, root webapp/).
# Only its local build/install output is excluded; the backend project does not build it.
webapp/node_modules/
webapp/dist/
webapp/.vercel/
