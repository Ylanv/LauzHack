    "priority_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 50
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "finding_type": {
            "type": "string",
            "enum": [
              "confirmed_exposure",
              "potential_exposure",
              "protective_factor",
              "data_gap",
              "source_conflict"
            ]
          },
          "observation": {
            "type": "string",
            "maxLength": 420
          },
          "underwriting_implication": {
            "type": "string",
            "maxLength": 480
          },
          "recommended_action": {
            "type": "string",
            "maxLength": 280
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 25
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
