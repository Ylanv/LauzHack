                "type": "string"
              },
              "maxItems": 25
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 25
            },
            "unknown_feature_ids": {
              "type": "array",
              "items": {
                "type": "string"
