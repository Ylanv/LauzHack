    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 50
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "question": {
            "type": "string",
            "maxLength": 250
          },
          "reason_for_underwriter": {
            "type": "string",
            "maxLength": 360
          },
          "expected_answer_or_document": {
            "type": "string",
            "maxLength": 240
          },
          "target": {
            "type": "string",
            "enum": [
              "client",
              "internal_axa",
              "risk_engineer",
              "valuation_expert"
            ]
          },
          "feature_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 25
          },
          "trigger_finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 25
          },
          "blocking_initial_pricing": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "priority",
          "question",
          "reason_for_underwriter",
          "expected_answer_or_document",
          "target",
          "feature_ids",
          "trigger_finding_ids",
          "blocking_initial_pricing"
        ]
      },
      "maxItems": 8
    },
    "underwriter_next_step": {
      "type": "string",
      "maxLength": 500
    }
