{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "executive_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 150
        },
        "overview": {
          "type": "string",
          "maxLength": 700
        },
        "underwriting_readiness": {
          "type": "string",
          "enum": [
            "ready_for_initial_review",
            "requires_clarification",
            "specialist_review_recommended",
            "building_identity_unresolved"
          ]
        },
        "key_takeaway": {
          "type": "string",
          "maxLength": 300
        },
        "critical_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 25
        }
      },
      "required": [
        "headline",
        "overview",
        "underwriting_readiness",
        "key_takeaway",
        "critical_fact_ids"
      ]
    },
    "cope": {
      "type": "object",
      "additionalProperties": false,
