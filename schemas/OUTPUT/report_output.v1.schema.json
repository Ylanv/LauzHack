              "type": "string",
              "enum": [
                "fire",
                "regulated_natural_hazards",
                "earthquake_optional",
                "water_optional",
                "glass_optional",
                "other_optional"
              ]
            },
            "maxItems": 6
          }
        },
        "required": [
          "id",
          "title",
          "priority",
          "finding_type",
          "observation",
          "underwriting_implication",
          "recommended_action",
          "confidence",
          "fact_ids",
          "evidence_ids",
          "coverage_components"
        ]
      },
      "maxItems": 6
    },
    "hazard_interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "peril": {
            "type": "string",
            "enum": [
              "fire",
              "river_flood",
              "surface_runoff",
              "earthquake",
              "hail",
              "windstorm",
              "landslide",
              "rockfall",
              "avalanche",
              "snow_load",
              "water_escape",
              "other"
