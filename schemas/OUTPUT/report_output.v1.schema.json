          "pricing_role": {
            "type": "string",
            "enum": [
              "potential_individual_pricing_input",
              "regulated_component_underwriting_only",
              "coverage_dependent",
              "not_assessed"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 25
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 25
