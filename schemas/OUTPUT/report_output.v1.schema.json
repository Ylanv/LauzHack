          "title": {
            "type": "string",
            "maxLength": 90
          },
          "caption": {
            "type": "string",
            "maxLength": 350
          },
          "underwriting_relevance": {
            "type": "string",
            "maxLength": 340
          },
          "annotation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 25
