  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXA Smart Property — LLM Underwriting Narrative Output",
  "description": "The model returns analytical text and references to immutable facts/evidence, never raw fetched data or embedded images. Fields are renderer-controlled outside this object."
}
