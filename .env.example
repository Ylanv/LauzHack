# Copier en .env (jamais commité). En prod : Vercel → Settings → Environment Variables.
# NE JAMAIS mettre de vraie clé dans ce fichier : il est suivi par git.

# --- LLM / vision : n'importe quelle API compatible OpenAI (OpenRouter = clé AXA) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Vision (orthophoto + photos du site) et extraction du site : doivent accepter images + json_schema.
MODEL_VISION=google/gemini-2.5-flash-lite
MODEL_EXTRACTION=google/gemini-2.5-flash-lite
# Rapport final (étape après llm_input.json)
MODEL_SYNTHESIS=anthropic/claude-haiku-5.5

# --- Imagerie de rue (optionnel) ---
# Google Cloud Console → activer "Street View Static API" → Identifiants → Clé API
GOOGLE_MAPS_API_KEY=
MAPILLARY_TOKEN=

# --- Cache LLM en prod (Vercel) : Upstash Redis via Vercel Marketplace ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
