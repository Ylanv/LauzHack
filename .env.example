# Copier en .env (local). En prod : Vercel → Settings → Environment Variables (ou `vercel env add`).

# --- LLM : n'importe quelle API compatible OpenAI ---
# OpenRouter (clé AXA, $10)   https://openrouter.ai/api/v1
# Together (secours)          https://api.together.xyz/v1
# Nebius Token Factory        voir la doc Nebius pour l'URL de base
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Noms de modèles tels que chez le fournisseur choisi.
# Vision : doit accepter les images. Tous : doivent accepter response_format json_schema.
MODEL_VISION=
MODEL_EXTRACTION=
MODEL_SYNTHESIS=

# --- Cache (prod Vercel) : Upstash Redis via Vercel Marketplace ---
# L'intégration injecte KV_REST_API_URL / KV_REST_API_TOKEN, ou utiliser ces noms :
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1 = /api/report renvoie l'exemple (0 token) ; 0 = vraie pipeline
MOCK_MODE=1
