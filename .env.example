# Copier en .env (jamais commité). En prod : Vercel → Settings → Environment Variables.
# NE JAMAIS mettre de vraie clé dans ce fichier : il est suivi par git.

# --- Vision : n'importe quelle API compatible OpenAI (OpenRouter = clé AXA) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Doivent accepter images + response_format json_schema.
MODEL_VISION=google/gemini-2.5-flash-lite
MODEL_EXTRACTION=google/gemini-2.5-flash-lite

# --- Photo de façade (démo) : Google Cloud Console → activer "Street View Static API" → Clé API ---
GOOGLE_MAPS_API_KEY=

# --- Cache LLM en prod (Vercel) : Upstash Redis via Vercel Marketplace ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Access code required by the paid API endpoints (X-Access-Code header / "Code d'accès" field) ---
ACCESS_CODE=
